# Vercel Project Settings > Environment Variables에 등록. 실제 값은 Git에 커밋하지 않음.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
APP_ORIGIN=https://edu-apply-02.vercel.app
# 충분히 긴 난수. Node.js: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# 구글 연동: GOOGLE_CALENDAR_SETUP.md 참고. 모두 서버에서만 사용.
GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_WEB_OAUTH_CLIENT_SECRET
OWNER_GOOGLE_EMAIL=paran95@gmail.com
# 기존 계정의 UUID: OWNER_LOGIN_SETUP.md의 조회 SQL로 확인. 기존 일정 보존에 필요.
OWNER_NOTEBOOK_USER_ID=YOUR_EXISTING_NOTEBOOK_USER_UUID
# 32바이트 난수를 base64로 인코딩한 값. DB 밖의 서버 환경 변수에 보관.
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
