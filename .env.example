# Vercel Project Settings > Environment Variables에 등록. 실제 값은 Git에 커밋하지 않음.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=https://edu-apply-02.vercel.app
# 충분히 긴 난수. Node.js: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
